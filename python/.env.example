# Optional: PostgreSQL URL, e.g. postgresql+asyncpg://app:app@localhost:5432/app. Without it, the components
# run with no database (the probes skip it) and `migrate` refuses to run.
DATABASE_URL=
DATABASE_READ_URL=
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_S=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
READY_TIMEOUT_S=2
