# Optional: PostgreSQL URL, e.g. postgresql+asyncpg://app:app@localhost:5432/app. Without it, the components
# run with no database (the probes skip it) and `migrate` refuses to run.
DATABASE_URL=
DATABASE_READ_URL=
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_S=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
READY_TIMEOUT_S=2
# Optional: object storage (S3), one private and one public bucket at most, each used when its name is set.
# Any S3-compatible server works locally (Garage, MinIO...).
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_PRIVATE_BUCKET=
S3_PRIVATE_ACCESS_KEY_ID=
S3_PRIVATE_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PUBLIC_ACCESS_KEY_ID=
S3_PUBLIC_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_CONNECT_TIMEOUT_S=3
S3_TIMEOUT_S=30
