    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "overrides": {
