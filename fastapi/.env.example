DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
READY_TIMEOUT_S=2
DRAIN_DELAY_S=5
SHUTDOWN_TIMEOUT_S=20
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_BODY_BYTES=1048576
IDEMPOTENCY_TTL_S=86400
