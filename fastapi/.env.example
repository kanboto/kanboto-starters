PORT=8080
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
DATABASE_READ_URL=
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_S=10
DB_POOL_SIZE=5
