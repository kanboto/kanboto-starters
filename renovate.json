{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "automergeType": "pr",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "automerge": true,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "ignorePaths": [
    ".github/**"
  ],
  "enabledManagers": [
    "npm",
    "pep621",
    "dockerfile"
  ],
  "packageRules": [
    {
      "description": "Runtime versions follow the Kanboto CI kit (Node 24, Python 3.13): never bumped here",
      "matchDepTypes": [
        "engines",
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "Base images: digest refreshes only, tags follow the CI kit",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "base image digests",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm",
        "pep621"
      ],
      "matchFileNames": [
        "fastapi/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "fastapi starter non-major",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm",
        "pep621"
      ],
      "matchFileNames": [
        "nuxt/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "nuxt starter non-major",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm",
        "pep621"
      ],
      "matchFileNames": [
        "taskiq/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "taskiq starter non-major",
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
